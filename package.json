    "@react-three/rapier": "^2.2.0",
    "@recast-navigation/three": "^0.43.0",
    "@tweenjs/tween.js": "^25.0.0",
    "colyseus.js": "^0.16.22",
    "gl-matrix": "^3.4.4",
    "immer": "^10.2.0",
    "koota": "^0.6.2",
    "leva": "^0.10.1",
    "next": "^16.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-three-game": "^0.0.63",
    "recast-navigation": "^0.43.0",
    "three": "^0.182.0",
    "three-text": "^0.4.4",
    "trystero": "^0.22.0",
