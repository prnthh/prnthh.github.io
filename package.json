  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack --experimental-https\" \"npm run watch-manifests\"",
    "watch-manifests": "chokidar public --initial --ignore '**/manifest.json' -c 'sh generate-manifests.sh'",
    "prebuild": "next telemetry disable",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "server": "npm --prefix server start"
  },
