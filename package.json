    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@types/xml2js": "^0.4.14",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
